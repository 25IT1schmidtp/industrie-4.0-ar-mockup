  {
    "id": "fmt",
    "type": "function",
    "z": "tab_vib",
    "name": "Nachricht bauen",
    "func": "// Die erste Nachricht nach dem Subscribe ist nur die Subscription-ID\nif (msg.topic === \"subscriptionId\") return null;\n\nconst value = Number(msg.payload);\nif (!Number.isFinite(value)) return null;\n\nmsg.payload = {\n  source: \"P-101 Vibration\",\n  nodeId: \"ns=2;s=Demo.Alarms.Plant.PowerHouse.P-101.Vibration\",\n  value: Math.round(value * 1000) / 1000,\n  unit: \"mm/s\",\n  timestamp: new Date().toISOString(),\n  limits: { high: 4.5, highHigh: 7.1 }\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "ws_out",
        "mqtt_topic",
        "db_ins",
        "ui_gauge",
        "ui_text"
      ]
    ],
    "x": 700,
    "y": 100
  },
