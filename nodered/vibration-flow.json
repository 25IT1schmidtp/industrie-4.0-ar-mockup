  {
    "id": "avg_out",
    "type": "function",
    "z": "tab_vib",
    "name": "Antwort",
    "func": "const row = (msg.payload && msg.payload[0]) || { avg: null, count: 0 };\nmsg.payload = { avg: row.avg, count: row.count, unit: \"mm/s\", windowSeconds: 300 };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
