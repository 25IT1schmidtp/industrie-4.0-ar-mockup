  {
    "id": "db_schema",
    "type": "function",
    "z": "tab_vib",
    "name": "Schema",
    "func": "const sql = [\n  \"CREATE TABLE IF NOT EXISTS sensor (\\n  id      INTEGER PRIMARY KEY,\\n  node_id TEXT    NOT NULL UNIQUE,   -- OPC-UA-NodeId\\n  name    TEXT    NOT NULL,\\n  unit    TEXT    NOT NULL\\n);\",\n  \"CREATE TABLE IF NOT EXISTS measurement (\\n  id        INTEGER PRIMARY KEY AUTOINCREMENT,\\n  sensor_id INTEGER NOT NULL REFERENCES sensor(id),\\n  ts        INTEGER NOT NULL,        -- Unix-Zeit in Millisekunden (UTC)\\n  value     REAL    NOT NULL\\n);\",\n  \"CREATE INDEX IF NOT EXISTS idx_measurement_sensor_ts ON measurement(sensor_id, ts);\",\n  \"INSERT OR IGNORE INTO sensor (id, node_id, name, unit)\\nVALUES (1, 'ns=2;s=Demo.Alarms.Plant.PowerHouse.P-101.Vibration', 'P-101 Vibration', 'mm/s');\"\n];\nreturn [sql.map(s => ({ topic: s, payload: \"\" }))];",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "ddl_delay"
      ]
    ],
    "x": 320,
    "y": 360
  },
  {
    "id": "ddl_delay",
    "type": "delay",
    "z": "tab_vib",
    "name": "der Reihe nach",
    "pauseType": "rate",
    "timeout": "5",
    "timeoutUnits": "seconds",
    "rate": "5",
    "nbRateUnits": "1",
    "rateUnits": "second",
    "randomFirst": "1",
    "randomLast": "5",
    "randomUnits": "seconds",
    "drop": false,
    "allowrate": false,
    "outputs": 1,
    "x": 480,
