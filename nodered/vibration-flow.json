  {
    "id": "db_ins",
    "type": "function",
    "z": "tab_vib",
    "name": "INSERT",
    "func": "const v = Number(msg.payload.value);\nconst ts = Date.parse(msg.payload.timestamp);\nif (!Number.isFinite(v) || !Number.isFinite(ts)) return null;\nreturn { topic: \"INSERT INTO measurement (sensor_id, ts, value) VALUES (1, \" + ts + \", \" + v + \")\", payload: \"\" };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "sql_ins"
      ]
    ],
    "x": 700,
