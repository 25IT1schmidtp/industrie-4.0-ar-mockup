  {
    "id": "avg_sql",
    "type": "function",
    "z": "tab_vib",
    "name": "Query Ø 5 min",
    "func": "msg.topic = \"SELECT AVG(value) AS avg, COUNT(*) AS count FROM measurement WHERE sensor_id = 1 AND ts >= (CAST(strftime('%s', 'now') AS INTEGER) - 300) * 1000\";\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "sql_avg"
      ]
    ],
    "x": 340,
    "y": 510
  },
  {
    "id": "sql_avg",
    "type": "sqlite",
    "z": "tab_vib",
    "mydb": "db",
    "sqlquery": "msg.topic",
    "sql": "",
    "name": "Ø",
    "x": 520,
